# Hugging Face Configuration
# HF_TOKEN: Optional API token for gated or private Hugging Face models (e.g. meta-llama/Llama-2-7b-chat-hf)
HF_TOKEN=

# HF_HOME: Directory where downloaded Hugging Face models and datasets are cached
HF_HOME=./.cache/huggingface

# PyTorch & Hardware Configuration
# Force PyTorch to use CPU only (useful for testing fallback): 0 or 1
CUDA_VISIBLE_DEVICES=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
